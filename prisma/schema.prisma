generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  files        File[]
  auditLogs    AuditLog[]
}

model File {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  storagePath   String
  size          Int
  uploadedAt    DateTime        @default(now())
  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int             @default(0)
  viewOnly      Boolean         @default(false)
  viewCount     Int             @default(0)
  accessLogs    LinkAccessLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model LinkAccessLog {
  id         String   @id @default(uuid())
  fileId     String?
  file       File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  accessType String
  ipAddress  String?
  userAgent  String?
  region     String?
  accessedAt DateTime @default(now())
}

model P2PSignal {
  id        String   @id @default(uuid())
  roomId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())
}
